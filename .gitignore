# .gitignore

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment variables
.env
.env.*
!*.env.example

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Generated reports, container exports, and Python runtime data
coverage/
*.tar
__pycache__/
*.py[cod]
*.db
enguia/live_data.json
enguia/trim_status.json
enguia/user_settings.json
